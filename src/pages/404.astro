---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Page Not Found">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-24 text-center">
    <h1 class="font-display text-4xl font-bold mb-3 text-ink">Page not found</h1>
    <p class="text-ink-soft mb-8">
      That page wandered off the shelf. Let's get you back to what's in stock.
    </p>
    <a
      href="/"
      class="inline-block bg-primary hover:bg-primary-dark text-white font-semibold px-5 py-2.5 rounded-md no-underline transition-colors"
    >
      ← Back to the store
    </a>
  </main>
  <Footer />
</Layout>
