---
import Icon from "./Icon.astro";
---

<!-- Shopping List Drawer / Modal -->
<div id="shopping-list-backdrop" class="hidden fixed inset-0 bg-black/60 z-50 items-center justify-center p-4 backdrop-blur-sm">
  <div id="shopping-list-modal" class="bg-surface rounded-2xl max-w-lg w-full max-h-[85vh] flex flex-col relative shadow-2xl border border-border overflow-hidden">
    <!-- Header -->
    <div class="px-6 py-4 border-b border-border flex items-center justify-between bg-bg">
      <div class="flex items-center gap-2">
        <Icon name="shoppingBag" class="w-5 h-5 text-primary" />
        <h2 class="text-lg font-bold text-ink font-display m-0">My Shopping List</h2>
        <span id="saved-items-count-badge" class="bg-primary/10 text-primary text-xs font-bold px-2 py-0.5 rounded-full">0 items</span>
      </div>
      <button id="close-shopping-list-btn" aria-label="Close" class="w-8 h-8 rounded-full bg-surface border border-border flex items-center justify-center text-ink-soft hover:text-ink hover:bg-bg transition-colors">
        <Icon name="x" class="w-4 h-4" />
      </button>
    </div>

    <!-- Body / Items List -->
    <div id="shopping-list-body" class="p-6 overflow-y-auto flex-1 space-y-3 min-h-[150px]">
      <!-- Populated via JavaScript -->
      <div id="empty-shopping-list" class="text-center py-10 space-y-2">
        <div class="w-12 h-12 rounded-full bg-bg mx-auto flex items-center justify-center text-ink-soft">
          <Icon name="heart" class="w-6 h-6" />
        </div>
        <div class="text-ink font-semibold text-base">Your shopping list is empty</div>
        <p class="text-ink-soft text-xs max-w-xs mx-auto">
          Tap the heart icon on any product to save items for your next visit to McNab Food Store!
        </p>
      </div>
    </div>

    <!-- Footer with estimated total & action buttons -->
    <div id="shopping-list-footer" class="p-4 border-t border-border bg-bg space-y-3 hidden">
      <div class="flex items-center justify-between text-sm font-semibold">
        <span class="text-ink-soft">Estimated Total:</span>
        <span id="shopping-list-total" class="text-ink text-xl font-bold font-display">$0.00</span>
      </div>

      <div class="flex items-center gap-2">
        <button id="clear-shopping-list-btn" class="flex-1 bg-surface border border-border hover:bg-red-50 hover:text-red-600 hover:border-red-200 text-ink-soft font-semibold text-xs py-2.5 rounded-lg transition-colors flex items-center justify-center gap-1.5 min-h-10">
          <Icon name="trash" class="w-3.5 h-3.5" />
          <span>Clear List</span>
        </button>
        <button id="print-shopping-list-btn" class="flex-1 bg-primary hover:bg-primary-dark text-white font-semibold text-xs py-2.5 rounded-lg transition-colors flex items-center justify-center gap-1.5 min-h-10 shadow-sm">
          <Icon name="check" class="w-3.5 h-3.5" />
          <span>Print / Show In-Store</span>
        </button>
      </div>
    </div>
  </div>
</div>
