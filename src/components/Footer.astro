---
import { STORE } from "../config";
const year = new Date().getFullYear();
---

<footer class="bg-navy text-white mt-16">
  <div class="max-w-6xl mx-auto px-6 py-10 grid grid-cols-1 sm:grid-cols-3 gap-8">
    <div>
      <div class="font-display font-bold text-lg mb-2">{STORE.name}</div>
      <p class="text-white/60 text-sm leading-relaxed">{STORE.tagline}</p>
    </div>
    <div>
      <div class="font-semibold text-sm mb-2 text-white/90">Visit</div>
      <p class="text-white/60 text-sm leading-relaxed">{STORE.address}</p>
      <p class="text-white/60 text-sm leading-relaxed">{STORE.hoursText}</p>
    </div>
    <div>
      <div class="font-semibold text-sm mb-2 text-white/90">Get in touch</div>
      <a href="#inquiry" class="text-primary font-medium text-sm hover:underline">Send a message →</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6 py-4 text-white/50 text-xs">
      &copy; {year} {STORE.name}. All items and prices subject to availability.
    </div>
  </div>
</footer>
