---
import { STORE } from "../config";
import Icon from "./Icon.astro";
---

<section class="max-w-6xl mx-auto px-6 mt-8">
  <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-navy via-slate-900 to-indigo-950 text-white p-6 md:p-10 border border-white/10 shadow-xl">
    <!-- Subtle glow background decoration -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-80 h-80 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="space-y-3 text-center lg:text-left max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md border border-white/15 px-3 py-1 rounded-full text-xs font-semibold text-emerald-300">
          <Icon name="truck" class="w-3.5 h-3.5" />
          <span>Doorstep Delivery Available</span>
        </div>
        <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight text-white font-display">
          Need Snacks, Drinks & Essentials Delivered?
        </h2>
        <p class="text-slate-300 text-sm md:text-base leading-relaxed">
          Craving your favorite snacks, icy cold beverages, or quick household essentials? We've partnered with <strong class="text-white">DoorDash</strong> and <strong class="text-white">UberEats</strong> for fast local delivery straight from <span class="text-emerald-400 font-semibold">{STORE.name}</span>!
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs font-medium text-slate-300">
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
            ⚡ Fast 30-Min Delivery
          </span>
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
            🧊 Fresh & Cold Items
          </span>
          <span class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1.5 rounded-lg">
            📍 Serving Tamarac & Nearby
          </span>
        </div>
      </div>

      <!-- Action Buttons Card -->
      <div class="w-full lg:w-auto bg-white/5 backdrop-blur-xl border border-white/10 p-6 rounded-xl flex flex-col sm:flex-row lg:flex-col gap-4 shrink-0 min-w-[280px]">
        <a
          href={STORE.delivery.doordash}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex items-center justify-between gap-4 bg-red-600 hover:bg-red-500 text-white font-bold px-6 py-4 rounded-xl transition-all shadow-lg hover:shadow-red-600/30 no-underline"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center text-white font-extrabold text-sm">
              DD
            </div>
            <div class="text-left">
              <div class="text-xs font-medium opacity-90">Order on</div>
              <div class="text-lg leading-tight font-black">DoorDash</div>
            </div>
          </div>
          <Icon name="externalLink" class="w-5 h-5 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" />
        </a>

        <a
          href={STORE.delivery.ubereats}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative flex items-center justify-between gap-4 bg-zinc-900 hover:bg-black text-white border border-emerald-500/40 font-bold px-6 py-4 rounded-xl transition-all shadow-lg hover:shadow-emerald-500/20 no-underline"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-extrabold text-sm">
              UE
            </div>
            <div class="text-left">
              <div class="text-xs font-medium text-emerald-400">Order on</div>
              <div class="text-lg leading-tight font-black text-white">UberEats</div>
            </div>
          </div>
          <Icon name="externalLink" class="w-5 h-5 text-emerald-400 group-hover:translate-x-0.5 transition-all" />
        </a>
      </div>
    </div>
  </div>
</section>
