---
import { STORE } from "../config";
import Icon from "./Icon.astro";
import PromoBar from "./PromoBar.astro";
---

<header class="bg-surface border-b border-border relative md:sticky top-0 z-30 shadow-xs">
  <!-- Promo Announcement Bar -->
  <PromoBar />

  <!-- Utility bar -->
  <div class="bg-navy text-white text-xs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-1.5 flex flex-wrap justify-between items-center gap-2">
      <a
        href={STORE.mapDirectionsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-white/80 hover:text-white transition-colors no-underline text-[11px] sm:text-xs truncate max-w-[240px] sm:max-w-none"
      >
        <Icon name="mapPin" class="w-3.5 h-3.5 shrink-0 text-emerald-400" />
        <span class="truncate">{STORE.address}</span>
      </a>

      <div class="flex items-center gap-3">
        {
          STORE.phone && (
            <a
              href={`tel:${STORE.phone.replace(/[^0-9+]/g, "")}`}
              class="flex items-center gap-1.5 text-white/80 hover:text-white transition-colors no-underline font-semibold text-[11px] sm:text-xs"
            >
              <Icon name="phone" class="w-3.5 h-3.5 shrink-0 text-emerald-400" />
              <span>{STORE.phone}</span>
            </a>
          )
        }
        <span class="text-white/80 hidden sm:inline">{STORE.hoursText}</span>
        <span id="open-badge" class="flex items-center gap-1.5 text-[11px] font-semibold">
          <span id="open-dot" class="w-2 h-2 rounded-full bg-white/40"></span>
          <span id="open-label" class="hidden sm:inline">Checking hours…</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Main header -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-2.5 sm:py-4 flex items-center justify-between gap-3">
    <div>
      <a href="/" class="no-underline">
        <h1 class="font-display font-extrabold text-ink text-xl sm:text-2xl leading-tight m-0 tracking-tight">
          {STORE.name}
        </h1>
      </a>
      <p class="text-ink-soft text-xs mt-0.5 m-0 hidden sm:block">{STORE.tagline}</p>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a
        href="#inquiry"
        class="bg-primary hover:bg-primary-dark text-white font-semibold text-xs sm:text-sm px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-lg no-underline whitespace-nowrap transition-colors min-h-9 sm:min-h-11 flex items-center shadow-xs"
      >
        Contact Us
      </a>
    </div>
  </div>

  <!-- Payment badges (hidden on tiny screens to save space) -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-2.5 hidden sm:flex flex-wrap gap-2">
    {
      STORE.payments.map((p) => (
        <span class="flex items-center gap-1.5 text-[11px] font-medium text-ink-soft bg-bg border border-border rounded-full px-2.5 py-1">
          <Icon name={p.icon as any} class="w-3 h-3 shrink-0 text-ink-soft" />
          {p.label}
        </span>
      ))
    }
  </div>
</header>

<script define:vars={{ openHour: STORE.hours.openHour, closeHour: STORE.hours.closeHour }}>
  function updateOpenBadge() {
    const dot = document.getElementById("open-dot");
    const label = document.getElementById("open-label");
    if (!dot || !label) return;
    const hour = new Date().getHours();
    const isOpen = hour >= openHour && hour < closeHour;
    if (label) label.textContent = isOpen ? "Open Now" : "Closed Right Now";
    dot.classList.toggle("bg-success", isOpen);
    dot.classList.toggle("bg-danger", !isOpen);
    dot.classList.toggle("bg-white/40", false);
  }
  updateOpenBadge();
  setInterval(updateOpenBadge, 60000);
</script>
