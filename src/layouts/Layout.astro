---
import "../styles/global.css";
import { STORE } from "../config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${STORE.name} — Fresh Items, Daily Deals & Local Convenience`,
  description = `${STORE.tagline}. Browse what's in stock at ${STORE.name}, ${STORE.address}. ${STORE.hoursText}.`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.svg", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ConvenienceStore",
  name: STORE.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: STORE.address,
  },
  telephone: STORE.phone || undefined,
  openingHours: `Mo-Su ${String(STORE.hours.openHour).padStart(2, "0")}:00-${String(
    STORE.hours.closeHour
  ).padStart(2, "0")}:00`,
  url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="theme-color" content="#0F1B2D" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
